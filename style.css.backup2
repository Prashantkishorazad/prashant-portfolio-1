* { margin: 0; padding: 0; box-sizing: border-box; }

:root {
  --bg: #efece4;
  --bg-alt: #e8e3d7;
  --ink: #1a1a1a;
  --ink-soft: #4a4a4a;
  --muted: #8a8377;
  --line: #d9d2c1;
  --accent: #e56b1f;
  --serif: 'Instrument Serif', serif;
  --sans: 'Inter', sans-serif;
  --mono: 'JetBrains Mono', monospace;
}

html { scroll-behavior: smooth; }

body {
  background-color: var(--bg);
  background-image: radial-gradient(circle, #d8d3c7 0.6px, transparent 0.9px);
  background-size: 6px 6px;
  color: var(--ink);
  font-family: var(--sans);
  font-size: 15px;
  line-height: 1.55;
  overflow-x: hidden;
}

a { color: inherit; text-decoration: none; }
img { max-width: 100%; display: block; }
ul { list-style: none; }

/* ============ TOPBAR ============ */
.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px 36px;
  border-bottom: 1px solid var(--line);
  font-family: var(--mono);
  font-size: 11px;
  letter-spacing: 1px;
  text-transform: uppercase;
  position: sticky;
  top: 0;
  background: rgba(239, 236, 228, 0.92);
  backdrop-filter: blur(10px);
  z-index: 100;
}

.topbar-left { display: flex; align-items: center; gap: 10px; }
.topbar-left .dot {
  width: 6px; height: 6px;
  border-radius: 50%;
  background: var(--accent);
}
.brand { font-weight: 600; }
.sep { color: var(--muted); }
.muted { color: var(--muted); }

.topbar-nav { display: flex; gap: 28px; }
.topbar-nav a { color: var(--ink-soft); transition: color 0.2s; }
.topbar-nav a:hover { color: var(--accent); }

.topbar-right { display: flex; align-items: center; gap: 12px; }

.status-dot {
  width: 8px; height: 8px;
  border-radius: 50%;
  background: #22c55e;
  box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.2);
}

/* ============ HERO ============ */
.hero {
  padding: 60px 60px 0;
  border-bottom: 1px solid var(--line);
}

.hero-grid {
  display: grid;
  grid-template-columns: 1.4fr 1fr;
  gap: 60px;
  padding-bottom: 60px;
}

.hero-meta {
  font-family: var(--mono);
  font-size: 11px;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: var(--muted);
  display: flex;
  gap: 14px;
  margin-bottom: 32px;
}

.hero-meta .dash { opacity: 0.5; }

.hero-title {
  font-family: var(--serif);
  font-size: clamp(60px, 9vw, 130px);
  line-height: 0.92;
  font-weight: 400;
  letter-spacing: -2px;
  margin-bottom: 32px;
}

.hero-title em { font-style: italic; color: var(--accent); }

.hero-sub {
  font-size: 16px;
  max-width: 560px;
  margin-bottom: 40px;
  color: var(--ink-soft);
}

.dropcap {
  font-family: var(--serif);
  font-size: 42px;
  float: left;
  line-height: 0.8;
  margin: 6px 8px 0 0;
  color: var(--accent);
  font-style: italic;
}

.hero-sub b { color: var(--ink); font-weight: 600; }

.hero-info-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 22px 40px;
  padding: 24px 0;
  border-top: 1px solid var(--line);
  border-bottom: 1px solid var(--line);
  margin-bottom: 32px;
  max-width: 560px;
}

.hero-info-grid .label {
  display: block;
  font-family: var(--mono);
  font-size: 10px;
  letter-spacing: 2px;
  color: var(--muted);
  margin-bottom: 4px;
}

.hero-info-grid .value { font-size: 13px; color: var(--ink); }

.hero-btns { display: flex; gap: 10px; flex-wrap: wrap; }

.hero-btns a {
  font-family: var(--mono);
  font-size: 11px;
  letter-spacing: 1.5px;
  padding: 10px 16px;
  border: 1px solid var(--ink);
  transition: all 0.2s;
}

.hero-btns a:hover { background: var(--ink); color: var(--bg); }

.hero-right { position: relative; align-self: start; padding-top: 20px; }

.fig-label {
  font-family: var(--mono);
  font-size: 10px;
  letter-spacing: 2px;
  color: var(--muted);
  margin-bottom: 8px;
}

.fig-frame {
  border: 1px solid var(--ink);
  padding: 12px;
  background: var(--bg);
}

.fig-frame img {
  width: 100%;
  aspect-ratio: 1;
  object-fit: cover;
  filter: saturate(0.9) contrast(1.05);
}

/* TICKER */
.ticker {
  display: flex;
  gap: 30px;
  padding: 16px 0;
  border-top: 1px solid var(--line);
  font-family: var(--mono);
  font-size: 11px;
  letter-spacing: 1.5px;
  color: var(--ink-soft);
  overflow-x: auto;
  white-space: nowrap;
  text-transform: uppercase;
}

.ticker span:nth-child(even) { color: var(--accent); }

/* ============ SECTION ============ */
.section { padding: 80px 60px; border-bottom: 1px solid var(--line); }

.section-head {
  display: grid;
  grid-template-columns: 200px 1fr;
  gap: 40px;
  margin-bottom: 60px;
  align-items: baseline;
}

.section-num {
  font-family: var(--mono);
  font-size: 11px;
  letter-spacing: 2px;
  color: var(--muted);
  text-transform: uppercase;
}

.section-head h2 {
  font-family: var(--serif);
  font-size: clamp(40px, 5vw, 68px);
  font-weight: 400;
  letter-spacing: -1.5px;
  line-height: 1;
}

.section-head h2 em { font-style: italic; color: var(--accent); }

/* ============ ABOUT ============ */
.about-grid {
  display: grid;
  grid-template-columns: 1fr 1.4fr 1fr;
  gap: 50px;
}

.about-left .meta-block {
  padding: 14px 0;
  border-bottom: 1px solid var(--line);
}

.about-left .meta-block:last-child { border-bottom: none; }

.label {
  display: block;
  font-family: var(--mono);
  font-size: 10px;
  letter-spacing: 2px;
  color: var(--muted);
  margin-bottom: 6px;
}

.about-center p {
  font-size: 16px;
  margin-bottom: 20px;
  color: var(--ink-soft);
}

.about-center em {
  font-family: var(--serif);
  font-style: italic;
  color: var(--accent);
  font-size: 1.1em;
}

.about-center b { color: var(--ink); font-weight: 600; }

.signature {
  font-family: var(--serif);
  font-style: italic;
  font-size: 22px !important;
  color: var(--ink) !important;
  margin-top: 10px;
}

.about-right p {
  font-size: 14px;
  color: var(--ink-soft);
  margin-bottom: 16px;
}

/* ============ WORK ============ */
.work-list { display: flex; flex-direction: column; }

.work-item {
  display: grid;
  grid-template-columns: 80px 1fr;
  gap: 30px;
  padding: 32px 0;
  border-bottom: 1px solid var(--line);
  transition: 0.3s;
}

.work-item:hover { padding-left: 10px; }

.work-badge {
  width: 52px; height: 52px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--mono);
  font-size: 11px;
  letter-spacing: 1px;
  background: var(--accent);
  color: var(--bg);
  border: 1px solid var(--accent);
}

.work-top {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 20px;
  margin-bottom: 6px;
}

.work-top h3 {
  font-family: var(--serif);
  font-size: 26px;
  font-weight: 400;
}

.work-status {
  font-family: var(--mono);
  font-size: 10px;
  letter-spacing: 1.5px;
  padding: 4px 10px;
  background: var(--ink);
  color: var(--bg);
}

.work-sub {
  font-family: var(--mono);
  font-size: 11px;
  letter-spacing: 1px;
  color: var(--muted);
  margin-bottom: 14px;
  display: flex;
  gap: 10px;
}

.work-desc {
  font-size: 14.5px;
  color: var(--ink-soft);
  max-width: 720px;
  margin-bottom: 14px;
}

.tags { display: flex; gap: 8px; flex-wrap: wrap; }

.tags span {
  font-family: var(--mono);
  font-size: 10px;
  letter-spacing: 1px;
  padding: 4px 10px;
  border: 1px solid var(--line);
  color: var(--ink-soft);
  text-transform: uppercase;
}

/* ============ PROJECTS ============ */
.filter-row {
  display: flex;
  gap: 10px;
  margin-bottom: 40px;
  flex-wrap: wrap;
}

.filter {
  font-family: var(--mono);
  font-size: 11px;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  padding: 10px 18px;
  border: 1px solid var(--line);
  background: transparent;
  cursor: pointer;
  transition: 0.2s;
  color: var(--ink-soft);
}

.filter span { color: var(--muted); margin-left: 6px; }

.filter:hover, .filter.active {
  background: var(--ink);
  color: var(--bg);
  border-color: var(--ink);
}

.filter.active span { color: var(--accent); }

.projects-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 0;
  border-top: 1px solid var(--line);
  border-left: 1px solid var(--line);
}

.project-card {
  border-right: 1px solid var(--line);
  border-bottom: 1px solid var(--line);
  padding: 32px 28px;
  min-height: 260px;
  display: flex;
  flex-direction: column;
  position: relative;
  transition: 0.3s;
  background: var(--bg);
}

.project-card:hover { background: var(--bg-alt); }

.project-card.featured {
  grid-column: span 3;
  display: grid;
  grid-template-columns: 1.3fr 1fr;
  gap: 40px;
  padding: 50px;
  min-height: 380px;
  align-items: center;
}

.project-tag {
  font-family: var(--mono);
  font-size: 10px;
  letter-spacing: 2px;
  color: var(--muted);
  text-transform: uppercase;
  margin-bottom: 16px;
  display: block;
}

.project-logo {
  width: 52px; height: 52px;
  border-radius: 10px;
  overflow: hidden;
  margin-bottom: 14px;
  border: 1px solid var(--line);
  background: var(--bg);
  display: flex;
  align-items: center;
  justify-content: center;
}

.project-logo img { width: 100%; height: 100%; object-fit: contain; }

.project-title {
  font-family: var(--serif);
  font-size: 40px;
  font-weight: 400;
  line-height: 1;
  margin-bottom: 16px;
  letter-spacing: -1px;
}

.project-title em { font-style: italic; color: var(--accent); }

.project-desc {
  font-size: 14px;
  color: var(--ink-soft);
  margin-bottom: 20px;
}

.project-chips {
  display: flex;
  gap: 6px;
  flex-wrap: wrap;
  margin-top: auto;
}

.project-chips span {
  font-family: var(--mono);
  font-size: 10px;
  padding: 3px 8px;
  border: 1px solid var(--line);
  color: var(--ink-soft);
}

.project-repo {
  font-family: var(--mono);
  font-size: 11px;
  letter-spacing: 1.5px;
  color: var(--accent);
  margin-top: 14px;
  display: inline-block;
}

.project-btns { display: flex; gap: 16px; margin: 20px 0; }

.project-btns a {
  font-family: var(--mono);
  font-size: 11px;
  letter-spacing: 1.5px;
  padding: 8px 14px;
  border: 1px solid var(--ink);
  color: var(--ink);
  transition: 0.2s;
}

.project-btns a:hover { background: var(--ink); color: var(--bg); }

.project-visual { display: flex; justify-content: center; align-items: center; }

.project-img {
  width: 100%;
  border: 1px solid var(--line);
  background: var(--bg);
}

.project-thumb {
  width: 100%;
  height: 140px;
  overflow: hidden;
  border: 1px solid var(--line);
  margin-bottom: 18px;
  background: var(--bg-alt);
}

.project-thumb img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* ============ WRITING ============ */
.writing-list { display: flex; flex-direction: column; }

.writing-item {
  padding: 32px 0;
  border-bottom: 1px solid var(--line);
  max-width: 860px;
}

.writing-meta {
  font-family: var(--mono);
  font-size: 11px;
  letter-spacing: 2px;
  color: var(--muted);
  text-transform: uppercase;
  display: flex;
  gap: 12px;
  margin-bottom: 14px;
}

.writing-meta .dash { opacity: 0.5; }

.writing-item h3 {
  font-family: var(--serif);
  font-size: 26px;
  font-weight: 400;
  margin-bottom: 10px;
}

.writing-italic {
  font-family: var(--serif);
  font-style: italic;
  font-size: 16px;
  color: var(--accent);
  margin-bottom: 12px;
}

.writing-item p:last-of-type {
  font-size: 14.5px;
  color: var(--ink-soft);
  margin-bottom: 16px;
}

.writing-link {
  font-family: var(--mono);
  font-size: 11px;
  letter-spacing: 1.5px;
  color: var(--accent);
  border-bottom: 1px solid var(--accent);
  padding-bottom: 2px;
}

.skills-block {
  margin-top: 60px;
  padding-top: 40px;
  border-top: 1px solid var(--line);
}

.skills-title {
  font-family: var(--serif);
  font-size: 32px;
  font-weight: 400;
  margin-bottom: 32px;
}

.skills-title em { font-style: italic; color: var(--accent); }

.skills-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 30px;
}

.skills-grid p { font-size: 13px; color: var(--ink-soft); line-height: 1.7; }

/* ============ CONTACT ============ */
.contact { padding-bottom: 100px; }

.contact-lead {
  font-size: 16px;
  color: var(--ink-soft);
  max-width: 720px;
  margin-bottom: 40px;
}

.contact-lead em {
  font-family: var(--serif);
  font-style: italic;
  color: var(--accent);
}

.contact-email {
  font-family: var(--serif);
  font-size: clamp(28px, 4vw, 54px);
  font-style: italic;
  color: var(--ink);
  border-bottom: 2px solid var(--accent);
  display: inline-block;
  margin-bottom: 40px;
  padding-bottom: 6px;
  transition: 0.3s;
}

.contact-email:hover { color: var(--accent); }

.contact-meta {
  font-family: var(--mono);
  font-size: 12px;
  letter-spacing: 1px;
  color: var(--muted);
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
}

.contact-meta a:hover { color: var(--accent); }

/* ============ FOOTER ============ */
.footer {
  padding: 24px 60px;
  display: flex;
  justify-content: space-between;
  font-family: var(--mono);
  font-size: 11px;
  letter-spacing: 1.5px;
  color: var(--muted);
  text-transform: uppercase;
}

.footer-right { display: flex; align-items: center; gap: 12px; }

/* ============ RESPONSIVE ============ */
@media (max-width: 1000px) {
  .hero-grid, .about-grid { grid-template-columns: 1fr; gap: 40px; }
  .section-head { grid-template-columns: 1fr; gap: 16px; }
  .topbar-nav { display: none; }
  .projects-grid { grid-template-columns: repeat(2, 1fr); }
  .project-card.featured { grid-column: span 2; grid-template-columns: 1fr; }
  .skills-grid { grid-template-columns: repeat(2, 1fr); }
}

@media (max-width: 640px) {
  .topbar, .hero, .section, .footer { padding-left: 20px; padding-right: 20px; }
  .projects-grid { grid-template-columns: 1fr; }
  .project-card.featured { grid-column: span 1; }
  .skills-grid { grid-template-columns: 1fr; }
  .work-item { grid-template-columns: 1fr; gap: 16px; }
  .hero-info-grid { grid-template-columns: 1fr; }
  .footer { flex-direction: column; gap: 12px; text-align: center; }
  .contact-email { font-size: 22px; }
}