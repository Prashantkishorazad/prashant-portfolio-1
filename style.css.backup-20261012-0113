  border-top: 1px solid var(--line) !important;
  width: 100% !important;
}

.footer-link {
  display: grid !important;
  grid-template-columns: 110px 1fr 20px !important;
  gap: 16px !important;
  align-items: center !important;
  padding: 18px 6px !important;
  border-bottom: 1px solid var(--line) !important;
  font-family: var(--mono) !important;
  font-size: 10.5px !important;
  letter-spacing: 1.4px !important;
  text-transform: lowercase !important;
  color: var(--ink-soft) !important;
  text-decoration: none !important;
  transition: 0.35s cubic-bezier(0.16, 1, 0.3, 1) !important;
}

.footer-link .link-label {
  text-transform: lowercase !important;
  color: var(--muted) !important;
  transition: 0.3s !important;
}

.footer-link .link-value {
  text-transform: lowercase !important;
  color: var(--ink-soft) !important;
  transition: 0.3s !important;
}

.footer-link .arrow {
  color: var(--muted) !important;
  text-align: right !important;
  transition: 0.35s cubic-bezier(0.16, 1, 0.3, 1) !important;
  font-size: 12px !important;
}

.footer-link:hover {
  padding-left: 14px !important;
}

.footer-link:hover .link-label,
.footer-link:hover .link-value {
  color: var(--ink) !important;
}

.footer-link:hover .arrow {
  color: var(--accent) !important;
  transform: translate(4px, -4px) !important;
}

/* ============ FOOTER BOTTOM — Vaibhavee style ============ */
.footer-bottom {
  display: flex !important;
  justify-content: space-between !important;
  align-items: center !important;
  padding-top: 30px !important;
  font-family: var(--mono) !important;
  font-size: 9.5px !important;
  letter-spacing: 1.5px !important;
  text-transform: lowercase !important;
  color: var(--muted) !important;
  flex-wrap: wrap !important;
  gap: 20px !important;
}

.footer-meta-left,
.footer-meta-right {
  text-transform: lowercase !important;
  white-space: nowrap !important;
}

@media (max-width: 1000px) {
  footer.footer { padding: 70px 30px 30px !important; }
  .footer-top {
    grid-template-columns: 1fr !important;
    gap: 60px !important;
  }
  .footer-left { padding-right: 0 !important; }
  .footer-bottom {
    flex-direction: column !important;
    text-align: center !important;
    align-items: center !important;
  }
  .footer-meta-left,
  .footer-meta-right { white-space: normal !important; text-align: center !important; }
}

@media (max-width: 640px) {
  footer.footer { padding: 50px 20px 24px !important; }
  .footer-link {
    grid-template-columns: 90px 1fr 16px !important;
    gap: 12px !important;
    font-size: 10px !important;
    padding: 14px 4px !important;
  }
}

