/* ============ ADVANCED ANIMATIONS ============ */

/* 1. Hero title letter fade-in */
@keyframes titleReveal {
  from { opacity: 0; transform: translateY(30px); filter: blur(8px); }
  to { opacity: 1; transform: translateY(0); filter: blur(0); }
}

.hero-title {
  animation: titleReveal 1.2s cubic-bezier(0.16, 1, 0.3, 1) both;
}

.hero-title em {
  display: inline-block;
  animation: titleReveal 1.2s cubic-bezier(0.16, 1, 0.3, 1) 0.2s both;
}

/* 2. Hero badge glow pulse */
@keyframes badgeGlow {
  0%, 100% { box-shadow: 0 0 0 rgba(229, 107, 31, 0); }
  50% { box-shadow: 0 0 24px rgba(229, 107, 31, 0.35); }
}

.hero-badge {
  animation: badgeGlow 3s ease-in-out infinite;
}

/* 3. Hero subtitle fade in from left */
@keyframes fadeInLeft {
  from { opacity: 0; transform: translateX(-20px); }
  to { opacity: 1; transform: translateX(0); }
}

.hero-sub {
  animation: fadeInLeft 1s cubic-bezier(0.16, 1, 0.3, 1) 0.4s both;
}

/* 4. Hero info grid stagger */
@keyframes staggerIn {
  from { opacity: 0; transform: translateY(16px); }
  to { opacity: 1; transform: translateY(0); }
}

.hero-info-grid > div {
  animation: staggerIn 0.7s cubic-bezier(0.16, 1, 0.3, 1) both;
}

.hero-info-grid > div:nth-child(1) { animation-delay: 0.5s; }
.hero-info-grid > div:nth-child(2) { animation-delay: 0.6s; }
.hero-info-grid > div:nth-child(3) { animation-delay: 0.7s; }
.hero-info-grid > div:nth-child(4) { animation-delay: 0.8s; }

/* 5. Photo frame subtle float */
@keyframes photoFloat {
  0%, 100% { transform: translateY(0) rotate(0deg); }
  50% { transform: translateY(-8px) rotate(0.5deg); }
}

.fig-frame {
  animation: photoFloat 6s ease-in-out infinite;
}

/* 6. Section heading hover lift */
.section-head h2 {
  transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
}

.section-head:hover h2 {
  transform: translateX(8px);
}

/* 7. Work logo continuous subtle glow */
@keyframes logoGlow {
  0%, 100% { box-shadow: 0 0 0 rgba(229, 107, 31, 0); }
  50% { box-shadow: 0 0 20px rgba(229, 107, 31, 0.2); }
}

.work-logo {
  animation: logoGlow 4s ease-in-out infinite;
}

/* 8. Project title gradient sweep */
@keyframes titleSweep {
  0% { background-position: 0% 50%; }
  100% { background-position: 200% 50%; }
}

.project-title em {
  background: linear-gradient(90deg, var(--accent) 0%, var(--accent) 40%, #ffb37a 50%, var(--accent) 60%, var(--accent) 100%);
  background-size: 200% auto;
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  animation: titleSweep 6s linear infinite;
}

/* 9. Filter buttons pop */
.filter {
  transition: transform 0.3s, background 0.3s, color 0.3s;
}

.filter:hover {
  transform: translateY(-2px);
}

.filter.active {
  transform: translateY(-2px);
  box-shadow: 0 6px 20px rgba(26, 26, 26, 0.15);
}

/* 10. Toolbelt item hover lift */
.toolbelt-col li {
  transition: transform 0.3s, color 0.3s;
}

.toolbelt-col li:hover {
  transform: translateX(4px);
  color: var(--accent);
}

/* 11. Certificate link arrow bounce */
@keyframes arrowBounce {
  0%, 100% { transform: translate(0, 0); }
  50% { transform: translate(3px, -3px); }
}

.cert-link:hover {
  animation: arrowBounce 0.6s ease-in-out infinite;
}

/* 12. Footer link hover slide */
.footer-link {
  transition: padding-left 0.35s cubic-bezier(0.16, 1, 0.3, 1), color 0.3s;
}

/* 13. Ticker slow-down on scroll */
.ticker {
  animation-duration: 25s;
}

.ticker:hover {
  animation-duration: 40s;
}

/* 14. Card border pulse multi-colour */
@keyframes borderColorShift {
  0%, 100% { border-color: var(--line); }
  33% { border-color: rgba(229, 107, 31, 0.4); }
  66% { border-color: rgba(167, 139, 250, 0.3); }
}

.project-card,
.work-item,
.writing-item {
  animation: borderColorShift 8s ease-in-out infinite;
}

/* 15. AI Bot window scale-in */
@keyframes aiBotIn {
  from { opacity: 0; transform: translateY(20px) scale(0.9); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}

.ai-bot-window.open {
  animation: aiBotIn 0.4s cubic-bezier(0.16, 1, 0.3, 1);
}

/* 16. Contact form input glow on focus */
@keyframes inputGlow {
  0%, 100% { box-shadow: 0 0 0 0 rgba(229, 107, 31, 0); }
  50% { box-shadow: 0 0 0 4px rgba(229, 107, 31, 0.15); }
}

.contact-form input:focus,
.contact-form textarea:focus {
  animation: inputGlow 2s ease-in-out infinite;
}

/* 17. Ticker text individual glow */
@keyframes tickerGlow {
  0%, 100% { color: var(--ink-soft); }
  50% { color: var(--accent); }
}

.ticker span:nth-child(4n+1) {
  animation: tickerGlow 4s ease-in-out infinite;
}

/* 18. Topbar dot pulse */
@keyframes topbarDot {
  0%, 100% { transform: scale(1); opacity: 1; }
  50% { transform: scale(1.5); opacity: 0.5; }
}

.topbar-left .dot {
  animation: topbarDot 2s ease-in-out infinite;
}

/* 19. Section number rotate on hover */
.section-num {
  transition: transform 0.4s;
}

.section-head:hover .section-num {
  transform: translateX(-6px);
}

/* 20. Whole page subtle grain */
@keyframes subtleGrain {
  0%, 100% { opacity: 0.02; }
  50% { opacity: 0.04; }
}

body::after {
  content: "";
  position: fixed;
  inset: 0;
  pointer-events: none;
  background-image: radial-gradient(circle at 50% 50%, rgba(0,0,0,0.06) 0%, transparent 70%);
  animation: subtleGrain 6s ease-in-out infinite;
  z-index: 1;
}

/* Reduce motion for accessibility */
@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}

