/* ============ EXTRA ANIMATIONS ============ */

/* Fade up on scroll — already there, add more */

/* Section number pulse */
@keyframes numPulse {
  0%, 100% { opacity: 0.6; }
  50% { opacity: 1; color: var(--accent); }
}

.section-num {
  animation: numPulse 5s ease-in-out infinite;
}

/* Logo subtle rotate on hover */
.work-logo {
  transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
}

.work-item:hover .work-logo {
  transform: rotate(-6deg) scale(1.08);
}

/* Project card image subtle zoom */
.project-img,
.project-thumb img {
  transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
}

.project-card:hover .project-img,
.project-card:hover .project-thumb img {
  transform: scale(1.03);
}

/* Section heading highlight sweep */
@keyframes sweepGlow {
  0%, 100% { text-shadow: 0 0 0 transparent; }
  50% { text-shadow: 0 0 24px rgba(229, 107, 31, 0.25); }
}

.section-head h2 em {
  animation: sweepGlow 6s ease-in-out infinite;
}

/* Hero buttons subtle float */
@keyframes buttonFloat {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-3px); }
}

.hero-btns a {
  transition: 0.3s;
}

.hero-btns a:hover {
  transform: translateY(-4px);
  box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1);
}

/* Status dot pulse */
@keyframes dotPulse {
  0%, 100% { transform: scale(1); opacity: 1; }
  50% { transform: scale(1.4); opacity: 0.6; }
}

.status-dot {
  animation: dotPulse 2s ease-in-out infinite;
}

/* Ticker smoother */
.ticker {
  animation: tickerScroll 25s linear infinite;
}

.ticker:hover {
  animation-play-state: paused;
}

/* Fade in for whole page */
body {
  animation: bodyFade 1.2s ease-out;
}

@keyframes bodyFade {
  from { opacity: 0; }
  to { opacity: 1; }
}

/* ============ REMOVE HOVER TILT ============ */
.work-item:hover {
  padding-left: 0 !important;
  transform: none !important;
}

.work-item {
  transform: none !important;
}

/* ============ CREAM COLOUR LINE ANIMATION ============ */
@keyframes lineFlow {
  0% { background-position: -200% 0; }
  100% { background-position: 200% 0; }
}

.work-item,
.project-card,
.writing-item,
.section-head,
.contact-block,
.footer-top {
  position: relative;
}

.work-item::after,
.project-card::after,
.writing-item::after {
  content: "";
  position: absolute;
  left: 0;
  bottom: -1px;
  width: 100%;
  height: 1px;
  background: linear-gradient(
    90deg,
    transparent 0%,
    rgba(229, 107, 31, 0.1) 25%,
    rgba(229, 107, 31, 0.6) 50%,
    rgba(229, 107, 31, 0.1) 75%,
    transparent 100%
  );
  background-size: 200% 100%;
  animation: lineFlow 6s linear infinite;
  pointer-events: none;
  opacity: 0.7;
}

/* Section dividers with cream line */
.section::before {
  content: "";
  position: absolute;
  top: 0;
  left: 60px;
  right: 60px;
  height: 1px;
  background: linear-gradient(
    90deg,
    transparent,
    rgba(217, 210, 193, 0.8) 50%,
    transparent
  );
  animation: lineFlow 8s linear infinite;
  background-size: 200% 100%;
}

/* Subtle shimmer on hover for cards */
@keyframes cardShimmer {
  0% { box-shadow: 0 0 0 rgba(229, 107, 31, 0); }
  50% { box-shadow: 0 0 30px rgba(229, 107, 31, 0.15); }
  100% { box-shadow: 0 0 0 rgba(229, 107, 31, 0); }
}

.project-card:hover,
.work-item:hover {
  animation: cardShimmer 2s ease-in-out;
}

