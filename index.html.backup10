        <strong>Ask Anything</strong>
        <small>Icogon AI Assistant</small>
      </div>
      <button class="ai-bot-close" id="aiBotClose">×</button>
    </div>

    <div class="ai-bot-messages" id="aiBotMessages">
      <div class="ai-msg ai-msg-bot">
        Hi! I'm Prashant's AI assistant. Ask me anything about him —
        his projects, Icogon, skills, or how to reach him.
      </div>
    </div>

    <form class="ai-bot-input" id="aiBotForm">
      <input type="text" id="aiBotInput" placeholder="Ask anything..." autocomplete="off" />
      <button type="submit" aria-label="Send">↑</button>
    </form>
  </div>
</div>

